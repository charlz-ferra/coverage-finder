{
  "name": "coverage-finder",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "dev": "pnpm --filter @coverage/web dev",
    "build": "pnpm --filter @coverage/web build",
    "preview": "pnpm --filter @coverage/web preview",
    "check": "pnpm -r --if-present check",
    "lint": "eslint .",
    "test": "pnpm -r --if-present test && vitest run --config apps/web/vitest.config.ts",
    "test:e2e": "playwright test",
    "size": "node scripts/check-size.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^9.27.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.15.0",
    "eslint": "^9.27.0",
    "eslint-plugin-svelte": "^3.6.0",
    "globals": "^16.2.0",
    "svelte": "^5.35.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.34.0",
    "vitest": "^3.2.4"
  }
}
